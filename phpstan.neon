includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Only used by the Volt page resources/views/pages/settings/⚡profile.blade.php,
    # which PHPStan doesn't read, so it would otherwise be reported as unused.
    excludePaths:
        - app/Concerns/ProfileValidationRules.php
